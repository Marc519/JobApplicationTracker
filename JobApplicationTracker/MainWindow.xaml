<Window x:Class="JobApplicationTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:JobApplicationTracker"
        mc:Ignorable="d"
        Title="MainWindow" Height="786" Width="1503">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!--Main info window-->
            <ScrollViewer x:Name="ApplicationPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid Grid.Column="1" Margin="20,20,20,9">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Here is the job title" Grid.Column="0" FontSize="34"/>
                        <TextBlock Text="Here is the date of application" Grid.Column="1" FontSize="20" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="Here is the company name" Grid.Row="1" FontSize="22" Margin="0,10,0,10"/>
                    <TextBlock Text="Here is the job link" Grid.Row="2" FontSize="22" Margin="0,10,0,10"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Here is the status of the application" Grid.Column="1" FontSize="20" HorizontalAlignment="Right"/>
                    </Grid>

                    <TextBlock TextWrapping ="Wrap" Text="Extra notes: lorem ipsum dolor sit amet consectetur adipiscing elit quibusdam corrupti corrupti ipsum laboris optio quo aut fugiat voluptas illum sunt accusamus dolorum labore fuga in laborum velit provident quibusdam sunt adipiscing blanditiis imperdiet ut pariatur dignissimos voluptas id aliquip elit libero et voluptate ullamco occaecat in eiusmod eiusmod nisi dolorem officia repellendus placeat dignissimos fugiat odio eos similique magna aliqua irure fugiat vero ut elit optio eum nulla aut ipsum voluptas aut assumenda et deserunt similique pariatur fugiat deserunt tempor officia cupiditate eu ut cum est dignissimos expedita illum occaecat proident voluptas mollit exercitation labore dolorum fuga culpa fugiat nisi excepturi est dolorem minim culpa anim esse id possimus assumenda aliquip aliqua in mollit sint sint dolor quo quos maxime officia dolor quos est do incididunt deserunt ducimus placeat incididunt ut id nulla ullamco sunt do nam aute autem cumque in aliqua excepteur deserunt voluptatum aut at elit temporibus dolorem dignissimos qui ad eum temporibus est voluptatum minim harum sit possimus est quis voluptas eu voluptate voluptas deleniti blanditiis dolorum occaecat vel consequatur animi provident est pariatur qui velit sed aut qui maxime culpa magna aliqua similique officia esse ex expedita est temporibus illum occaecat non et autem blanditiis vel dolorem dolor occaecat irure qui fugiat dignissimos possimus do tempore in officia animi fugiat quo facere ut id omnis qui occaecat irure cum esse aut quo cupidatat id rerum excepteur et autem cupidatat ex consequatur molestias cillum iusto dolor exercitation ut qui in distinctio adipiscing ullamco veniam illum dignissimos id dolor eu ut nostrud lorem in et mollit sint sint est fugiat expedita eum duis quos voluptas est et esse ullamco distinctio optio et aliquip dolor deleniti temporibus quod quas placeat ut officia quo id est quibusdam anim irure et dolore dolorem nisi maxime qui nihil sunt lorem aliquip facere mollit et eligendi quo dolores facilis at eiusmod expedita officia maxime in pariatur qui aliqua corrupti laboris id omnis quibusdam reprehenderit tempor excepteur et sunt velit est ut at in sit autem exercitation laboris elit ducimus incididunt ipsum proident excepteur elit distinctio in lorem possimus id quos non sint sunt cum dolore nulla non minus" Grid.Row="3" FontSize="22"/>
                </Grid>
            </ScrollViewer>
            
            <!--Left side preview window-->
            <Grid  Grid.Column="0" Background="#FFD6D6D6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions> 
                <!--Search window-->
                <TextBox Background="{x:Null}" Text="Search..." VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#FFABADB3" Margin="10,0,10,0">
                </TextBox>
                <!--Job application search results-->
                <ListView x:Name="ApplicationPreviewPanel" Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Stretch" ItemsSource="{Binding}" Background="{x:Null}" >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#FF717171" Margin="0,0,0,0" BorderThickness="0,0,0,1">
                                <Grid Height="83" Margin="10,10,10,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding JobTitle}" Grid.Column="0" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding CompanyName}" Grid.Column="0" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding ApplicationDate}" Grid.Column="1" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
                    <Button x:Name="PrevPage" Content=" Previous " Height="30" Click="PrevPage_Click"/>
                    <TextBlock x:Name="PageNumberDisplay" Text="{Binding}" Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button x:Name="NextPage" Content=" Next " Height="30" Click="NextPage_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
</Window>
